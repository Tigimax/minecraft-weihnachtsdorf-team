# Weihnachtsdorf 7 Identity Management Configuration Template
# Copy this file to /etc/default/wd-identity or /opt/wd-identity/.env and set your secrets.

# OpenLDAP Settings
LDAP_URI=ldaps://192.168.1.164:636
LDAP_BIND_DN=uid=svc-authentik,ou=ServiceAccounts,dc=ldap-01,dc=net
LDAP_BIND_PASSWORD=YOUR_LDAP_BIND_PASSWORD
LDAP_BASE_DN=dc=ldap-01,dc=net
LDAP_USER_OU=ou=User,dc=ldap-01,dc=net
LDAP_GROUP_OU=ou=Groups,dc=ldap-01,dc=net
LDAP_ADMIN_GROUP=cn=wd_admins,ou=Groups,dc=ldap-01,dc=net
LDAP_MOD_GROUP=cn=wd_mods,ou=Groups,dc=ldap-01,dc=net
LDAP_PLAYER_GROUP=cn=wd_players,ou=Groups,dc=ldap-01,dc=net

# Project Launch State File
PROJECT_STATE_FILE=/var/lib/wd-identity/project_state.json

# Authentik Settings
AUTHENTIK_BASE_URL=https://auth.tigimax.mooo.com
AUTHENTIK_API_URL=http://127.0.0.1:9000
AUTHENTIK_TOKEN=YOUR_AUTHENTIK_API_TOKEN
AUTHENTIK_INVITATION_FLOW_UUID=9c936c43-2dad-40d9-a980-7c3054a5c414
AUTHENTIK_INVITATION_FLOW_SLUG=invitation-enrollment-flow
AUTHENTIK_RECOVERY_FLOW_SLUG=default-recovery-flow

# Minecraft Server (Node 2 Wings API)
WINGS_API_URL=http://192.168.1.149:8080
WINGS_SERVER_UUID=a173d02e-4efc-4f53-bc4f-4dd42f99c6f8
WINGS_BEARER_TOKEN=YOUR_WINGS_BEARER_TOKEN

# Planka Integration (Postgres via SSH on usrv01)
PLANKA_SSH_HOST=192.168.1.174
PLANKA_SSH_USER=tigimax
PLANKA_CONTAINER=planka-postgres-1
PLANKA_DB_NAME=planka
PLANKA_DB_USER=planka

# Discord Bot Settings
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# Webhook & API Server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
