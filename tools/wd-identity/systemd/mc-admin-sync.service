[Service]
Type=oneshot
User=tigimax
Group=tigimax
WorkingDirectory=/opt/wd-identity
EnvironmentFile=-/etc/default/wd-identity
ExecStart=/opt/wd-identity/bin/mc-admin-sync

[Install]
